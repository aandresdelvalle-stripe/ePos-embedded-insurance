# Frontend: backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8080

# Frontend: Terminal server URL for Stripe S700 (no trailing slash)
# VITE_TERMINAL_URL=https://your-terminal-server.example.com

# Frontend: Stripe Terminal reader ID (optional if using discover with location)
# VITE_READER_ID=tmr_...

# Frontend: Stripe Terminal location ID for discovering readers (optional)
# VITE_TERMINAL_LOCATION=tml_...

# Server: Stripe secret key (required for /products from Stripe catalog)
# STRIPE_SECRET_KEY=sk_test_...

# Server: Stripe Connect connected account ID (insurance company) for post-payment transfer
# STRIPE_CONNECTED_ACCOUNT_ID=acct_...
